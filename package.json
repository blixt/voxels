{
  "name": "voxels",
  "version": "0.2.0",
  "private": true,
  "description": "A Rust-first procedural voxel world rendered with WebGPU",
  "type": "module",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.ts --release"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.131.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.8.2",
      "onFail": "download"
    }
  }
}
